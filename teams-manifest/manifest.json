{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
  "manifestVersion": "1.16",
  "version": "1.0.0",
  "id": "00000000-0000-0000-0000-000000000001",
  "packageName": "com.company.incident-support-assistant",
  "developer": {
    "name": "Your Company",
    "websiteUrl": "https://your-company.com",
    "privacyUrl": "https://your-company.com/privacy",
    "termsOfUseUrl": "https://your-company.com/terms"
  },
  "name": {
    "short": "Incident Assistant",
    "full": "AI Incident Support Assistant"
  },
  "description": {
    "short": "AI-powered incident support for Microsoft Teams",
    "full": "An AI assistant that provides real-time incident status, troubleshooting guidance, and knowledge base access directly in Microsoft Teams. Ask about incident status, outages, past resolutions, and recommended troubleshooting steps."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#6264A7",
  "bots": [
    {
      "botId": "${MICROSOFT_APP_ID}",
      "scopes": ["personal", "team", "groupchat"],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "commandLists": [
        {
          "scopes": ["personal", "team", "groupchat"],
          "commands": [
            {
              "title": "help",
              "description": "Show available commands and examples"
            },
            {
              "title": "status",
              "description": "Check status of all services"
            },
            {
              "title": "active",
              "description": "List all active incidents"
            }
          ]
        }
      ]
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": ["your-bot-domain.azurewebsites.net", "*.ngrok-free.app"]
}
